# PAISIO_VIDEO_BASE_URL
PAISIO_VIDEO_BASE_URL=https://api.paisio.online/v1
# PIXEL_TOYS_PIXVERSE_API_KEY (optional; falls back to PIXEL_TOYS_IMAGE_N1N_API_KEY)
PIXEL_TOYS_PIXVERSE_API_KEY=
# PIXEL_TOYS_PIXVERSE_BASE_URL
PIXEL_TOYS_PIXVERSE_BASE_URL=https://llm-api.net
# CANVAS_PUBLIC_ASSET_BASE_URL
CANVAS_PUBLIC_ASSET_BASE_URL=
# CANVAS_VIDEO_PROVIDER
CANVAS_VIDEO_PROVIDER=
