# Pixel Toys / PixelTale 环境变量参考（.env.example）
# 复制为 .env.local 后按需填写。密钥不要提交到 git。
# 模型端点与 key 配对提示：
#   - DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1 时 DEEPSEEK_API_KEY 必须是官方 sk- key；
#   - 若走聚合网关(apikey.fun/beefapi)则必须用网关签发的 key，官方 key 会被网关拒绝(401)。
#   - PIXELTALE_GEMINI_MODEL 指定 PixelTale 主创可用的 Gemini 模型 id（如 gemini-3.1-pro）。

# ARK_ASSETS_ACCESS_KEY_ID
ARK_ASSETS_ACCESS_KEY_ID=
# ARK_ASSETS_ENDPOINT
ARK_ASSETS_ENDPOINT=
# ARK_ASSETS_PROJECT_NAME
ARK_ASSETS_PROJECT_NAME=
# ARK_ASSETS_REGION
ARK_ASSETS_REGION=
# ARK_ASSETS_SECRET_ACCESS_KEY
ARK_ASSETS_SECRET_ACCESS_KEY=
# ARK_BASE_URL
ARK_BASE_URL=
# ARK_VIRTUAL_PERSON_GROUP_ID
ARK_VIRTUAL_PERSON_GROUP_ID=
# ASSET_ANALYZER_API_KEY
ASSET_ANALYZER_API_KEY=
# ASSET_ANALYZER_BASE_URL
ASSET_ANALYZER_BASE_URL=
# ASSET_ANALYZER_FALLBACK_TIMEOUT_MS
ASSET_ANALYZER_FALLBACK_TIMEOUT_MS=
