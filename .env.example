PIXEL_TOYS_VIDEO_N1N_API_KEY=
# GROK_VIDEO_BASE_URL（grok-imagine-video-1.5-preview；默认复用 llm-api.net/v1）
GROK_VIDEO_BASE_URL=https://llm-api.net/v1
# GROK_VIDEO_API_KEY（可选；未配置时复用 PIXEL_TOYS_IMAGE_N1N_API_KEY）
