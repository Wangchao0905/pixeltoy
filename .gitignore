# ===== 依赖 / 构建产物 =====
node_modules/
.deploy-min/
public/dist/

# ===== 密钥 / 环境(绝不入库) =====
.env
.env.*
!.env.example

# ===== 用户数据 / 会话 / 用量(含密码哈希,绝不入库) =====
.pixel-toys-users.json
.pixel-toys-sessions.json
.pixel-toys-usage.json
.pixel-toys-teams.json

# ===== 运行时数据 / 生成产物(体积大、非源码) =====
projects/
outputs/
work/
.pixel-toys-canvas-states/
.pixel-toys-public-assets/
.pixel-toys-hidden-scene-references/
.pixel-toys-canvas-tail-frames/

# ===== 日志 / 临时 / PID =====
*.log
.pixel-toys-*.log
.pixel-toys-tunnel.pid

# ===== 各类备份(部署时逐文件留的时间戳备份) =====
*.bak
*.bak-*
*.bak.*
*.backup
*.backup-*

# ===== 工具二进制 / 第三方缓存 =====
tools/bin/
.superpowers/

